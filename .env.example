# Copy to .env and edit. Never commit .env.
# In Supabase Dashboard > Connect, choose Session pooler (port 5432).
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres:<URL-ENCODED-PASSWORD>@<SESSION-POOLER-HOST>:5432/postgres?sslmode=require
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:8000
FRONTEND_DIR=/app/frontend/dist
# --- Terrain analysis ---
TERRAIN_DATA_DIR=/app/data
ANALYSIS_TIMEOUT_S=300
ANALYSIS_CONCURRENCY=2
